{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "sampleId": {
      "type": "string",
      "minLength": 1
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "string": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                      },
                      "fret": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 36
                      }
                    },
                    "required": [
                      "string",
                      "fret"
                    ],
                    "additionalProperties": false
                  },
                  "uniqueItems": true
                },
                "rest": {
                  "type": "boolean"
                },
                "onset": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "n": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "d": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100000
                        }
                      },
                      "required": [
                        "n",
                        "d"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "duration": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "n": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "d": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100000
                        }
                      },
                      "required": [
                        "n",
                        "d"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "unknownReason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "region": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "id",
                "notes",
                "rest",
                "onset",
                "duration",
                "unknownReason",
                "region"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "events"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "sampleId",
    "measures"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
